name: "punc"
backend: "onnxruntime"
default_model_filename: "model.onnx"

max_batch_size: 64


input [
  {
    name: "inputs"
    data_type: TYPE_INT32
    dims: [-1]  #[BATCH_SIZE,FEATS_LENGTH]
  },
  {
    name: "text_lengths"
    data_type: TYPE_INT32
    dims: [1]
    reshape: { shape: [ ] }
  }
]

output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [-1,6]    # [BATCH_SIZE,feats_length,6(标点符号种类)]
  }
]

dynamic_batching {
  }
instance_group [
    {
      count: 2
      kind: KIND_CPU
    }
  ]
